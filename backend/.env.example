# Copia este archivo como ".env" y completa los valores. El archivo ".env" NO se sube a GitHub.

# Cadena de conexión de Supabase: Project Settings > Database > Connection string > URI
DATABASE_URL=postgresql://postgres:TU_PASSWORD_AQUI@db.TU_PROYECTO_REF.supabase.co:5432/postgres

# Texto largo y secreto para firmar los tokens JWT
JWT_SECRET=pon-aqui-un-texto-largo-y-secreto

# Usuarios que se crean la primera vez (cámbialos)
ADMIN_EMAIL=admin@ferreteriavaldez.com
ADMIN_PASSWORD=admin123
VENDEDOR_EMAIL=vendedor@ferreteriavaldez.com
VENDEDOR_PASSWORD=vendedor123

# true = crea productos de ejemplo la primera vez; false = base vacía
SEED_DEMO=true

# Dominio del frontend en Vercel (o * mientras pruebas)
CORS_ORIGINS=*

# Opcional: aviso a Slack cuando se registra una venta, compra o producto
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
